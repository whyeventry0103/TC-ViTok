\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textsc  {TC-ViTok} dataflow. Frozen encoders provide fine CLIP tokens, coarse DINOv2 features, and the text query. The TPN consumes only $(\mathbf  {q},\mathbf  {v}_{c})$, scores the 576-token CLIP grid, and the selected tokens pass through fixed merge, the LLaVA-1.5 projector, and LoRA-adapted decoding. Gray nodes are frozen, blue nodes are trained, green is parameter-free, orange is discrete selection, and dashed arrows carry selector scores.}}{4}{figure.caption.7}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{4}{\textsc {TC-ViTok} dataflow. Frozen encoders provide fine CLIP tokens, coarse DINOv2 features, and the text query. The TPN consumes only $(\qemb ,\vcoarse )$, scores the 576-token CLIP grid, and the selected tokens pass through fixed merge, the LLaVA-1.5 projector, and LoRA-adapted decoding. Gray nodes are frozen, blue nodes are trained, green is parameter-free, orange is discrete selection, and dashed arrows carry selector scores}{figure.caption.7}{}}
