\toprule
\textbf{Term} & \textbf{Purpose} & \textbf{Weight} \\
\midrule
$\mathcal{L}_\mathrm{VQA}$ & NTP cross-entropy on answer tokens & 1.0 \\
$-H$ & Prevent spatial collapse of TPN & 0.02 \\
$\mathcal{L}_\mathrm{div}$ & Prevent query-ignoring & 0.1 \\
